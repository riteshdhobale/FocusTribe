# ─── StudyDate Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your credentials.

# Supabase — https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── Payment Gateways ─────────────────────────────────────────────
# StudyDate uses DUAL payment gateways:
#   • Razorpay       → India, Pakistan, Bangladesh, Nepal, Sri Lanka
#   • Dodo Payments  → All other international regions

# Razorpay — https://dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_xxx) for development, live keys (rzp_live_xxx) for production
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Dodo Payments — https://dashboard.dodopayments.com → Settings → API
# Mode: "test" for sandbox, "live" for production
VITE_DODO_PAYMENTS_MODE=test

# Dodo Product IDs — Create products in the Dodo dashboard and paste IDs here
VITE_DODO_PRODUCT_WEEKLY=YOUR_DODO_PRODUCT_WEEKLY_ID
VITE_DODO_PRODUCT_PRO=YOUR_DODO_PRODUCT_PRO_ID
VITE_DODO_PRODUCT_CAMPUS=YOUR_DODO_PRODUCT_CAMPUS_ID

# Demo Mode — set to "true" for investor demos (enables local Pro override)
# REMOVE or set to "false" in production!
VITE_DEMO_MODE=false
