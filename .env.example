# ─── StudyDate Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your credentials.

# Supabase — https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Razorpay — https://dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_xxx) for development, live keys (rzp_live_xxx) for production
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Demo Mode — set to "true" for investor demos (enables local Pro override)
# REMOVE or set to "false" in production!
VITE_DEMO_MODE=false
